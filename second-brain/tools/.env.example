# Copy to .env (local) or set as GitHub Actions secrets. NEVER commit real values.

# --- Where the vault lives -------------------------------------------------
# local  = the Drive folder mounted by Google Drive for Desktop (Windows)
# drive  = the Drive API via a service account (GitHub Actions / cloud)
VAULT_MODE=local

# LOCAL mode: full path to the mounted AI_Brain_Notes folder, e.g.
#   G:\Shared drives\<drive>\AI_Brain_Notes   (Windows)
VAULT_DIR=

# DRIVE mode: the full service-account key JSON (one line). Share the Shared
# Drive with this service account's email as Content manager.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google Keep -----------------------------------------------------------
KEEP_EMAIL=chriskeen77@gmail.com
KEEP_MASTER_TOKEN=          # aas_et/... obtained via gpsoauth (see keep_scrape.py)
KEEP_DAYS=1                 # look-back window each run

# --- Smart linking (optional) ---------------------------------------------
ANTHROPIC_API_KEY=          # if unset, linking uses deterministic rules
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Behaviour -------------------------------------------------------------
# KEEP_INBOX=1              # uncomment to NOT clear inbox items after filing
