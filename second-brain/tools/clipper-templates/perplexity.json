{
  "schemaVersion": "0.1.0",
  "name": "Perplexity Answer",
  "behavior": "create",
  "noteNameFormat": "{{title}}",
  "path": "00-Inbox",
  "noteContentFormat": "# {{title}}\n\n**Answer:** [Open original]({{url}})\n\n{{content}}",
  "properties": [
    { "name": "title", "value": "{{title}}", "type": "text" },
    { "name": "type", "value": "source", "type": "text" },
    { "name": "source", "value": "perplexity", "type": "text" },
    { "name": "source_url", "value": "{{url}}", "type": "text" },
    { "name": "created", "value": "{{date}}", "type": "date" },
    { "name": "tags", "value": "type/source,src/perplexity,status/inbox", "type": "multitext" },
    { "name": "related", "value": "", "type": "multitext" }
  ],
  "triggers": ["https://www.perplexity.ai/search/"]
}
